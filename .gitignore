# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env holds the Picovoice AccessKey and the tailnet host
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
# NOTE: /android is intentionally NOT ignored. We run `expo prebuild` once and then
# hand-edit the Kotlin (VoiceInteractionService, wake foreground service), so the
# native project is source, not build output. See CLAUDE.md "Prebuild is one-way".
/ios
