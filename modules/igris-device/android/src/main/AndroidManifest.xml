<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- A normal (install-time) permission: no prompt. The clock app's SET_ALARM
       handler requires callers to hold it. -->
  <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

  <!-- Runtime (dangerous) permissions: asked for from JS at first use, never at
       launch. Contacts to resolve "call mom"; CALL_PHONE to dial without a second
       tap. If CALL_PHONE is refused, calls fall back to the dialer, which needs none. -->
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.CALL_PHONE" />

  <!-- Android 11+ package visibility: without this, resolving the clock's
       handler can fail even though it is installed. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.SET_ALARM" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SHOW_ALARMS" />
    </intent>
    <!-- Binding Google TTS for the Hindi voice (HindiVoice.kt). -->
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE" />
    </intent>
    <intent>
      <action android:name="android.intent.action.DIAL" />
      <data android:scheme="tel" />
    </intent>
  </queries>

  <!-- Reading and answering notifications (and pressing a ringing alarm's Dismiss).
       No runtime permission exists for this: the user switches Igris on in
       Settings › Notification access, which the app opens for them. -->
  <application>
    <service
      android:name="expo.modules.igrisdevice.IgrisNotificationListener"
      android:label="Igris"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
