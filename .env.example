# igris-app — copy to .env and fill in. .env is gitignored.
# Expo inlines EXPO_PUBLIC_* into the JS bundle at build time, so NOTHING secret
# may use that prefix. Secrets go to EAS ("eas secret:create") or SecureStore.

# ── Lanes (PLAN.md decision #4) ───────────────────────────────────────────────
# Local lane: maestro on the Mac, reached over Tailscale. Use the tailnet
# hostname or 100.x address — NOT localhost, and NOT 127.0.0.1, which is the
# phone itself. maestro must be bound to 0.0.0.0:8000 for this to resolve.
EXPO_PUBLIC_MAESTRO_LOCAL_URL=http://your-mac.your-tailnet.ts.net:8000
# Cloud lane: Render. Cold start measured at 33.8s on 2026-09-22.
EXPO_PUBLIC_MAESTRO_CLOUD_URL=https://maestro-hvdz.onrender.com
# How long the health probe waits before giving up on the Mac and using Render.
EXPO_PUBLIC_LANE_PROBE_TIMEOUT_MS=1500

# ── Secrets — NEVER EXPO_PUBLIC_, never committed ─────────────────────────────
# Owner credentials are typed into the app's login screen at runtime and stored
# in expo-secure-store (Android Keystore). They are deliberately NOT here.
# Picovoice AccessKey, needed from Phase 5 (wake word). Inject via EAS secret.
PICOVOICE_ACCESS_KEY=

# (EXPO_PUBLIC_MAESTRO_SESSION_ID was removed 2026-09-24: every launch now starts a
# new conversation, and the shared `voice-v2` thread is opened from Chats. A value
# left in your .env is ignored.)

# Downloadable assets. Defaults to this repo's committed assets/manifest.json on
# GitHub raw, so changing a model URL never needs an app rebuild. Point it at a
# release asset once assets-v1 is cut.
EXPO_PUBLIC_ASSET_MANIFEST_URL=https://raw.githubusercontent.com/Psahu1296/igris-app/main/assets/manifest.json
